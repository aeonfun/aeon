{"id":"xmaquina","symbol":"deus","name":"XMAQUINA","web_slug":"xmaquina","asset_platform_id":"base","platforms":{"base":"0x940a319b75861014a220d9c6c144d108552b089b","solana":"7JoGUTeaXkjcMGa6xJP2idYNYiLreto1WnsACHnpw3Gd","peaq":"0x940a319b75861014a220d9c6c144d108552b089b"},"detail_platforms":{"base":{"decimal_place":18,"contract_address":"0x940a319b75861014a220d9c6c144d108552b089b","geckoterminal_url":"https://www.geckoterminal.com/base/tokens/0x940a319b75861014a220d9c6c144d108552b089b"},"solana":{"decimal_place":9,"contract_address":"7JoGUTeaXkjcMGa6xJP2idYNYiLreto1WnsACHnpw3Gd","geckoterminal_url":"https://www.geckoterminal.com/solana/tokens/7JoGUTeaXkjcMGa6xJP2idYNYiLreto1WnsACHnpw3Gd"},"peaq":{"decimal_place":18,"contract_address":"0x940a319b75861014a220d9c6c144d108552b089b","geckoterminal_url":"https://www.geckoterminal.com/peaq/tokens/0x940a319b75861014a220d9c6c144d108552b089b"}},"block_time_in_minutes":0,"hashing_algorithm":null,"categories":["Solana Ecosystem","Base Ecosystem","Peaq Ecosystem","Robotics"],"preview_listing":false,"public_notice":null,"additional_notices":[],"description":{"en":"XMAQUINA is a decentralized ecosystem designed to open access to the humanoid robotics economy. As robotics emerges as a major new technology sector, investment opportunities have historically been limited to venture capital firms and institutional investors. XMAQUINA connects onchain capital with private robotics markets through a governance-led DAO and capital markets infrastructure built specifically for the sector.\n\nThe DAO treasury has secured positions in several leading humanoid robotics companies, including firms such as Apptronik, Figure AI, 1X Technologies, Agility Robotics, and Neura Robotics. This structure gives the community exposure to a market that has traditionally been difficult for public market participants to access. Treasury strategy and capital deployment are governed by the DEUS token, allowing holders to collectively guide how the ecosystem evolves.\n\nAt the core of the architecture is the Robotics Capital Markets (RCM) Protocol, which brings private robotics assets onchain and enables liquid, permissionless markets around them. By transforming traditionally illiquid robotics investments into tradable digital assets, the protocol expands market access, introduces continuous price discovery, and establishes a new financial layer for the robotics economy.\n"},"links":{"homepage":["https://www.xmaquina.io/","https://dao.xmaquina.io/"],"whitepaper":"https://docs.xmaquina.io/","blockchain_site":["https://basescan.org/token/0x940A319B75861014A220D9c6c144d108552B089B","https://intel.arkm.com/explorer/token/xmaquina","https://peaqscan.xyz/contract/0x940a319b75861014a220d9c6c144d108552b089b/txs/transfers?view=contract","https://peaq.subscan.io/token/0x940a319b75861014a220d9c6c144d108552b089b","https://solscan.io/token/7JoGUTeaXkjcMGa6xJP2idYNYiLreto1WnsACHnpw3Gd"],"official_forum_url":["https://www.linkedin.com/company/xmaquina"],"chat_url":["https://discord.com/invite/xmaquina"],"announcement_url":[],"snapshot_url":null,"twitter_screen_name":"xmaquina","facebook_username":"","bitcointalk_thread_identifier":null,"telegram_channel_identifier":"","subreddit_url":null,"repos_url":{"github":[],"bitbucket":[]}},"image":{"thumb":"https://coin-images.coingecko.com/coins/images/68133/thumb/Screenshot_2025-08-07_at_8.52.11%E2%80%AFPM.png?1754901254","small":"https://coin-images.coingecko.com/coins/images/68133/small/Screenshot_2025-08-07_at_8.52.11%E2%80%AFPM.png?1754901254","large":"https://coin-images.coingecko.com/coins/images/68133/large/Screenshot_2025-08-07_at_8.52.11%E2%80%AFPM.png?1754901254"},"country_origin":"","genesis_date":null,"listing_price":null,"listing_currency":null,"listing_timestamp":null,"listing_source":null,"listing_source_url":null,"contract_address":"0x940a319b75861014a220d9c6c144d108552b089b","has_supply_breakdown":true,"sentiment_votes_up_percentage":null,"sentiment_votes_down_percentage":nul